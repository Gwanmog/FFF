# Copy to .streamlit/secrets.toml for local dev (that file is gitignored).
# On Streamlit Community Cloud, paste these into Settings -> Secrets instead.
#
# Every key here is OPTIONAL. With none of them set the app still runs: it shows
# curated country facts, username/password login, and Spotify search links.

# ── Live country facts (capital, population, flag, languages, currency) ────────
# Free key from https://restcountries.com/sign-up  (no credit card)
# Without this the Quick Facts card shows only curated data and says why.
RESTCOUNTRIES_API_KEY = "your-restcountries-key"

# ── Spotify playlist search ───────────────────────────────────────────────────
# https://developer.spotify.com/dashboard - create an app, no redirect URI needed.
# Without these the app falls back to a plain Spotify search link.
SPOTIFY_CLIENT_ID = "your-spotify-client-id"
SPOTIFY_CLIENT_SECRET = "your-spotify-client-secret"

# ── Google login ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Application type: Web application.
# Authorized redirect URI must EXACTLY match APP_URL below.
# Without these the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID = "your-google-client-id"
GOOGLE_CLIENT_SECRET = "your-google-client-secret"

# ── Public URL of this app ────────────────────────────────────────────────────
# Where Google sends users back after login. Defaults to http://localhost:8501.
# Set this on Streamlit Cloud to your real app URL, e.g.
# APP_URL = "https://funky-fresh-friday.streamlit.app"
APP_URL = "http://localhost:8501"

# ── Database ──────────────────────────────────────────────────────────────────
# Unset  -> local SQLite file (fine for development).
# Set    -> Postgres. REQUIRED on Streamlit Cloud: its disk is wiped on every
#           reboot, so a SQLite file there loses all accounts and history.
# Supabase: Project Settings -> Database -> Connection string -> URI,
# and use the "Transaction pooler" (port 6543) host.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST:6543/postgres"
